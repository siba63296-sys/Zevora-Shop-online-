# Supabase Configuration (Client & Server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Supabase service role key for backend elevated database access (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Cashfree Payment Gateway Configuration (Server-Side Only, NEVER exposed to client)
# Production credentials from Cashfree Merchant Dashboard
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Environment: PRODUCTION (default for live payments) or SANDBOX (for testing)
CASHFREE_ENV=PRODUCTION
# API version (defaults to 2023-08-01)
CASHFREE_API_VERSION=2023-08-01
